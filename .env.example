# Examples read these only when you explicitly run them; the SDK never loads .env.
RISEX_ACCOUNT=
RISEX_SIGNER_PRIVATE_KEY=
# Needed only by examples/register_signer.py.
RISEX_ACCOUNT_PRIVATE_KEY=

# Funded integration checks always select testnet explicitly.
RISEX_TEST_ACCOUNT=
RISEX_TEST_SIGNER_PRIVATE_KEY=
RISEX_RUN_INTEGRATION=0
RISEX_RUN_ACCOUNT_INTEGRATION=0
RISEX_RUN_TRADE_INTEGRATION=0
RISEX_TEST_MARKET_ID=1
RISEX_TEST_MAXIMUM_NOTIONAL=20
